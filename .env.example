# Required for auth, saved builds, and other community features
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: canonical public site origin for auth redirects, share links, and metadata
PUBLIC_SITE_URL=https://www.tyrhq.com

# Optional: public source repository URL shown in the footer
PUBLIC_REPO_URL=

# Optional: enables API key generation / revocation in /settings
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: enables the scheduled patch note sync at /api/cron/patch-notes.
# Vercel Cron sends this as `Authorization: Bearer <value>`; without it the
# route refuses to run rather than being an open write endpoint. The manual
# Sync buttons on /admin/articles work regardless.
CRON_SECRET=

# Optional: origin the patch note sync scrapes. Defaults to
# https://www.playtyr.com — override to point at a staging mirror.
PATCH_NOTES_SOURCE_ORIGIN=
