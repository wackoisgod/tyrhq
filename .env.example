# Required for auth, saved builds, and other community features
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: canonical public site origin for auth redirects, share links, and metadata
PUBLIC_SITE_URL=https://www.tyrhq.com

# Optional: public source repository URL shown in the footer
PUBLIC_REPO_URL=

# Optional: enables API key generation / revocation in /settings
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: email when an organizer application is approved or declined.
# Both must be set. Leave them empty here; real values stay in the host environment.
RESEND_API_KEY=
EMAIL_FROM=

# Optional: Steam Web API key for fetching persona names/avatars
# Get from https://steamcommunity.com/dev/apikey
STEAM_WEB_API_KEY=

# Required for Steam OIDC bridge (custom:steam provider in Supabase)
# See STEAM_OIDC_SETUP.md for complete setup instructions
# IMPORTANT: Paste STEAM_OIDC_PRIVATE_KEY as multi-line PEM, not escaped \n
STEAM_OIDC_PRIVATE_KEY=
STEAM_OIDC_CLIENT_ID=
STEAM_OIDC_CLIENT_SECRET=
STEAM_OIDC_ISSUER=
STEAM_OIDC_REDIRECT_ALLOWLIST=

# Optional: secret key for account merge/split flows (32+ random bytes)
MERGE_SECRET=
